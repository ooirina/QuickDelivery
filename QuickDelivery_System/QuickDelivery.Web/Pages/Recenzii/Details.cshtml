@page
@model QuickDelivery.Web.Pages.Recenzii.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 500px;">
        <div class="card-body text-center">
            <h2 class="text-info mb-3">Detalii Recenzie</h2>
            <hr />
            <div class="mb-4">
                <div class="display-4 text-warning">@Model.Recenzie.Nota / 5</div>
                <p class="text-muted">Nota acordată de <strong>@Model.Recenzie.Client?.Nume</strong></p>
            </div>
            <blockquote class="blockquote bg-light p-3 rounded">
                <p>"@Model.Recenzie.Comentariu"</p>
            </blockquote>
            <p class="text-start"><strong>Restaurant:</strong> @Model.Recenzie.Restaurant.Nume</p>
            <hr />
            <div class="d-flex justify-content-around">
                <a asp-page="./Index" class="btn btn-secondary">Înapoi</a>
                <a asp-page="./Edit" asp-route-id="@Model.Recenzie.Id" class="btn btn-warning">Editează</a>
            </div>
        </div>
    </div>
</div>