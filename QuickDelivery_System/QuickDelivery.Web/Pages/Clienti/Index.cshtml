@page
@model QuickDelivery.Web.Pages.Clienti.IndexModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Gestiune Clienți</h2>
        <a asp-page="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Adaugă Client nou
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Nume Client</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th class="text-end pe-4">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Client)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3">
                                        @item.Nume.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-bold">@item.Nume</span>
                                </div>
                            </td>
                            <td><i class="bi bi-envelope me-2 text-muted"></i>@item.Email</td>
                            <td><i class="bi bi-telephone me-2 text-muted"></i>@item.Telefon</td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill bg-white p-1">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning border-0 rounded-circle me-1" title="Editează">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info border-0 rounded-circle me-1" title="Detalii">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Șterge">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        background-color: #e7f1ff;
        color: #0d6efd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #6c757d;
        padding: 1.2rem 1rem;
    }

    .table tbody td {
        padding: 1rem;
    }

    .btn-group .btn:hover {
        background-color: rgba(0,0,0,0.05);
    }
</style>