@page
@model QuickDelivery.Web.Pages.Clienti.CreateModel

<div asp-validation-summary="All" class="text-danger"></div>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-6 text-primary"><i class="bi bi-person-plus"></i></div>
                    <h2 class="fw-bold">Client Nou</h2>
                    <p class="text-muted small">Completează datele pentru înregistrarea clientului</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Client.Nume" class="form-label fw-bold">Nume Complet</label>
                        <input asp-for="Client.Nume" class="form-control rounded-pill border-2" placeholder="Ex: Ion Popescu" />
                        <span asp-validation-for="Client.Nume" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Client.Email" class="form-label fw-bold">Adresă Email</label>
                        <input asp-for="Client.Email" class="form-control rounded-pill border-2" placeholder="nume@exemplu.com" />
                        <span asp-validation-for="Client.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Client.Telefon" class="form-label fw-bold">Număr Telefon</label>
                        <input asp-for="Client.Telefon" class="form-control rounded-pill border-2" placeholder="07xx xxx xxx" />
                        <span asp-validation-for="Client.Telefon" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">Salvează Clientul</button>
                        <a asp-page="Index" class="btn btn-link text-secondary">Înapoi la listă</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>