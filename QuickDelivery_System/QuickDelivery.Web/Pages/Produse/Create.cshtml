@page
@model QuickDelivery.Web.Pages.Produse.CreateModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 shadow p-4 bg-white rounded">
            <h2 class="text-primary mb-4"><i class="bi bi-plus-circle"></i> Adaugă Produs în Meniu</h2>
            <hr />
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Produs.Nume" class="fw-bold"></label>
                    <input asp-for="Produs.Nume" class="form-control" placeholder="Ex: Pizza Quattro Stagioni" />
                    <span asp-validation-for="Produs.Nume" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Produs.Pret" class="fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="Produs.Pret" class="form-control" />
                        <span class="input-group-text">RON</span>
                    </div>
                    <span asp-validation-for="Produs.Pret" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Produs.Descriere" class="fw-bold"></label>
                    <textarea asp-for="Produs.Descriere" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Produs.Descriere" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="fw-bold">Alege Restaurantul</label>
                    <select asp-for="Produs.RestaurantId" class="form-select shadow-sm border-primary" asp-items="ViewBag.RestaurantId">
                        <option value="">-- Selectează Restaurantul --</option>
                    </select>
                    <span asp-validation-for="Produs.RestaurantId" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="fw-bold">Categorie Produs</label>
                    <select asp-for="Produs.CategorieId" class="form-select border-primary shadow-sm" asp-items="ViewBag.CategorieId">
                        <option value="">-- Selectează Categoria --</option>
                    </select>
                    <span asp-validation-for="Produs.CategorieId" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Salvează Produsul</button>
                    <a asp-page="/Restaurante/Index" class="btn btn-outline-secondary">Înapoi la Restaurante</a>
                </div>
            </form>
        </div>
    </div>
</div>