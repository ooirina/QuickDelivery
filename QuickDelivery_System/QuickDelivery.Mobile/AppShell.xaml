<Shell
    x:Class="QuickDelivery.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QuickDelivery.Mobile"
    Shell.FlyoutBehavior="Disabled"
    Title="QuickDelivery.Mobile">

    <TabBar>
        <Tab Title="Restaurante">
            <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Coș">
            <ShellContent Title="Coșul meu" ContentTemplate="{DataTemplate local:CosPage}" Route="CosPage" />
        </Tab>
        <Tab Title="Istoric">
            <ShellContent Title="Istoric Comenzi" ContentTemplate="{DataTemplate local:IstoricPage}" Route="IstoricPage" />
        </Tab>
    </TabBar>
</Shell>
