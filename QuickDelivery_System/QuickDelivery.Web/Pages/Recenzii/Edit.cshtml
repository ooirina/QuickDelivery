@page
@model QuickDelivery.Web.Pages.Recenzii.EditModel
@{
    ViewData["Title"] = "Editează Recenzia";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-warning text-dark text-center">
                    <h3 class="mb-0">Modifică Recenzia</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Recenzie.Id" />
                        <input type="hidden" asp-for="Recenzie.ClientId" />

                        <div class="mb-3">
                            <label asp-for="Recenzie.Nota" class="form-label font-weight-bold"></label>
                            <input asp-for="Recenzie.Nota" class="form-control" type="number" min="1" max="5" />
                            <span asp-validation-for="Recenzie.Nota" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Recenzie.Comentariu" class="form-label font-weight-bold"></label>
                            <textarea asp-for="Recenzie.Comentariu" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Recenzie.Comentariu" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Restaurant</label>
                            <select asp-for="Recenzie.RestaurantId" class="form-select" asp-items="ViewBag.RestaurantId"></select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Autor Recenzie</label>
                            <input class="form-control bg-light" value="@Model.Recenzie.Client?.Nume" readonly />
                            <small class="text-muted">Autorul nu poate fi schimbat după publicare.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Salvează Modificările</button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">Anulează</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>