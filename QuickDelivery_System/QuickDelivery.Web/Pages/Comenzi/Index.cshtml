@page
@model QuickDelivery.Web.Pages.Comenzi.IndexModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Istoric Comenzi</h2>
        <a asp-page="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="bi bi-cart-plus-fill me-2"></i>Comandă Nouă
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Data Comenzii</th>
                        <th>Client</th>
                        <th>Restaurant</th>
                        <th>Produs</th>
                        <th>Statut</th> 
                        <th class="text-center">Total</th>
                        <th class="text-end pe-4">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Comanda)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@item.DataComanda.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small">@item.DataComanda.ToString("HH:mm")</div>
                            </td>
                            <td><span class="badge bg-info text-dark rounded-pill">@item.Client?.Nume</span></td>
                            <td><span class="fw-bold text-primary">@item.Restaurant?.Nume</span></td>
                            <td>@item.Produs?.Nume</td>

                            @* coloana statut *@
                            <td>
                                @{
                                    var badgeClass = item.Status switch
                                    {
                                        "Preluată" => "bg-primary",
                                        "În Preparare" => "bg-info text-dark",
                                        "În Livrare" => "bg-warning text-dark",
                                        "Livrată" => "bg-success",
                                        "Anulată" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill">@item.Status</span>
                            </td>

                            <td class="text-center">
                                <div class="fw-bold text-success">
                                    @((item.Produs?.Pret ?? 0) * item.Cantitate) RON
                                </div>
                                <div class="text-muted small">
                                    @item.Cantitate x @item.Produs.Pret.ToString("N2")
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill bg-white p-1">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning border-0 rounded-circle me-1" title="Editează">
                                        <i class="bi bi-pencil"></i> </a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info border-0 rounded-circle me-1"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0 rounded-circle"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>