@page
@model QuickDelivery.Web.Pages.Produse.IndexModel

@{
    ViewData["Title"] = "Meniu Produse";
}


<div class="container mt-4">
    @* Secțiune Categorii cu Imagini din folderul local *@
    <div class="mb-5">
        <h4 class="fw-bold mb-3">Ce ai poftă să mănânci?</h4>
        <div class="d-flex overflow-auto pb-3 gap-3" style="scrollbar-width: none; -ms-overflow-style: none;">

            @* Buton pentru resetare filtru *@
            <a asp-page="./Index" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm d-flex align-items-center justify-content-center">
                    <span class="fw-bold text-primary small">Toate</span>
                </div>
                <span class="small fw-bold text-dark mt-2">Meniu</span>
            </a>

            @if (Model.ListaCategorii != null)
            {
                @foreach (var cat in Model.ListaCategorii)
                {
                    <a href="?SearchString=@cat.Nume" class="category-card text-decoration-none shadow-sm">
                        <div class="icon-circle bg-white shadow-sm d-flex align-items-center justify-content-center p-2">
                            @* Construim calea către imagine folosind folderul local *@
                            <img src="~/images/categorii/@cat.Iconita"
                                 alt="@cat.Nume"
                                 asp-append-version="true"
                                 style="width: 100%; height: 100%; object-fit: contain;" />
                        </div>
                        <span class="small fw-bold text-dark mt-2">@cat.Nume</span>
                    </a>
                }
            }
        </div>
    </div>

    @* 2. Header Listă Produse *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Produse disponibile</h2>
        <a asp-page="Create" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Adaugă Produs
        </a>
    </div>

    @* 3. Grid Produse *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Produs)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 transition-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="fw-bold">@item.Nume</h5>
                            <span class="badge bg-success rounded-pill px-3 py-2">@item.Pret.ToString("N2") RON</span>
                        </div>
                        <p class="text-muted small my-2">@item.Descriere</p>
                        <div class="mt-3 p-2 bg-light rounded-3 d-flex align-items-center">
                            <i class="bi bi-shop me-2"></i>
                            <span class="small fw-bold">@item.Restaurant?.Nume</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3 d-flex gap-2">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill flex-grow-1">Editează</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill flex-grow-1">Șterge</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Stiluri pentru cardurile de categorie (iconițe) */
    .category-card {
        min-width: 95px;
        padding: 12px;
        background: #ffffff;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.2s ease-in-out;
    }

      /*  .category-card:hover {
            background: #ffffff;
            transform: translateY(-5px);
            border-color: #00c2e8; 
            /* Culoare tip Wolt */
