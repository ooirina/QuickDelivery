<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDelivery.Mobile.RecenziiPage"
             Title="Recenzii Clienți">

    <Grid RowDefinitions="Auto, *">
        <Label x:Name="lblRestaurant" Grid.Row="0" FontSize="20" FontAttributes="Bold" 
               HorizontalOptions="Center" Margin="10" TextColor="#512BD4"/>

        <CollectionView x:Name="reviewsList" Grid.Row="1" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" CornerRadius="10" BorderColor="#E0E0E0">
                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding NumeClient}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Nota, StringFormat='{0} ⭐'}" TextColor="Gold" FontAttributes="Bold" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Comentariu}" FontSize="14" TextColor="DimGray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>