@page
@model QuickDelivery.Web.Pages.Recenzii.DeleteModel
@{
    ViewData["Title"] = "Ștergere Recenzie";
}

<div class="container mt-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white mx-auto" style="max-width: 500px;">
        <div class="card-body p-4 text-center">
            @* Iconiță de avertizare *@
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill display-4"></i>
            </div>

            <h3 class="fw-bold text-dark mb-3">Confirmi ștergerea?</h3>
            <p class="text-muted mb-4">Ești sigur că dorești să elimini această recenzie? Această acțiune nu poate fi anulată.</p>

            @* Detalii Recenzie în format mic *@
            <div class="bg-light rounded-3 p-3 mb-4 text-start">
                <div class="mb-2">
                    <small class="text-muted d-block uppercase small fw-bold">RESTAURANT</small>
                    <span class="text-dark fw-semibold">@Model.Recenzie?.Restaurant?.Nume</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block uppercase small fw-bold">NOTĂ</small>
                    <span class="badge bg-warning text-dark">@Model.Recenzie?.Nota / 5</span>
                </div>
                <div>
                    <small class="text-muted d-block uppercase small fw-bold">COMENTARIU</small>
                    <span class="text-dark small">"@Model.Recenzie?.Comentariu"</span>
                </div>
            </div>

            @* Butoane de acțiune *@
            <form method="post" class="d-grid gap-2">
                <input type="hidden" asp-for="Recenzie.Id" />
                <button type="submit" class="btn btn-danger rounded-pill py-2 shadow-sm fw-bold">
                    Șterge Definitiv
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill py-2">
                    Anulează
                </a>
            </form>
        </div>
    </div>
</div>