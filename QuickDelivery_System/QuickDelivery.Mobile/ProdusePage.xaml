<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDelivery.Mobile.ProdusePage"
             Title="Meniu Restaurant">

    <Grid RowDefinitions="Auto, Auto, *">
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20" Margin="10,5">
            <Label Text="Produse Disponibile" FontSize="22" FontAttributes="Bold" />
            <Button Text="Vezi Recenzii 💬" BackgroundColor="Transparent" TextColor="#512BD4" 
                    FontAttributes="Bold" Clicked="OnViewReviewsClicked" />
        </HorizontalStackLayout>

        <CollectionView x:Name="categoriesList"
                Grid.Row="1"
                HeightRequest="45"
                SelectionMode="Single"
                SelectionChanged="OnCategoryChanged"
                Margin="10,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15,2" CornerRadius="15" BorderColor="#512BD4" BackgroundColor="#F0F0F0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#512BD4" />
                                        <Setter TargetName="catLabel" Property="Label.TextColor" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter TargetName="catLabel" Property="Label.TextColor" Value="Black" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label x:Name="catLabel" Text="{Binding Nume}" VerticalOptions="Center" FontAttributes="Bold" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="produseList" Grid.Row="2" Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" BorderColor="#512BD4">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nume}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Descriere}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Pret, StringFormat='{0:F2} RON'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Adaugă" Clicked="OnAddToCartClicked" 
                                    CommandParameter="{Binding .}" BackgroundColor="#FFC107" 
                                    TextColor="Black" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>