
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDelivery.Mobile.MainPage"
             Title="Restaurante Disponibile">

    <Grid RowDefinitions="Auto, *">
        <Label Text="QuickDelivery - Restaurante" 
           FontSize="22" 
           FontAttributes="Bold"
           HorizontalOptions="Center" 
           Padding="10"/>


            

        <!-- Lista de restaurante -->
        <CollectionView x:Name="listView"
                    Grid.Row="2"
                    Margin="10"
                    SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" CornerRadius="10" HasShadow="True" BorderColor="#512BD4">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRestaurantTapped" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <HorizontalStackLayout Spacing="15">
                            <Image Source="{Binding ImagineUrl}" WidthRequest="60" HeightRequest="60" Aspect="AspectFill" />

                            <VerticalStackLayout WidthRequest="160">
                                <Label Text="{Binding Nume}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Adresa}" FontSize="11" TextColor="DimGray" />
                                <Label Text="{Binding DistantaKm, StringFormat='{0:F1} km de tine'}"
                                   FontSize="12" TextColor="Green" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
