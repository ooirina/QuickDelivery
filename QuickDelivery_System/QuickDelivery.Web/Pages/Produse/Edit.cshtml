@page
@model QuickDelivery.Web.Pages.Produse.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Produs</h4>
<hr />
<div class="row justify-content-center">
    <div class="col-md-6 card shadow-sm p-4 border-0 rounded-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Produs.Id" />

            <div class="mb-3">
                <label asp-for="Produs.Nume" class="fw-bold"></label>
                <input asp-for="Produs.Nume" class="form-control rounded-pill" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Produs.Pret" class="fw-bold"></label>
                    <input asp-for="Produs.Pret" class="form-control rounded-pill" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Categorie</label>
                    <select asp-for="Produs.CategorieId" class="form-select rounded-pill" asp-items="ViewBag.CategorieId">
                        <option value="">-- Alege Categorie --</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Restaurant</label>
                <select asp-for="Produs.RestaurantId" class="form-select rounded-pill" asp-items="ViewBag.RestaurantId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Produs.Descriere" class="fw-bold"></label>
                <textarea asp-for="Produs.Descriere" class="form-control rounded-3" rows="3"></textarea>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary rounded-pill">Salvează Modificările</button>
                <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill">Înapoi la listă</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
