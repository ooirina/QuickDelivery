@page
@model QuickDelivery.Web.Pages.Categorii.DetailsModel
@{
    ViewData["Title"] = "Explorare Categorie";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="p-5 mb-4 rounded-3 shadow-lg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <div class="container-fluid py-3">
                    <h6 class="text-uppercase fw-bold opacity-75">DETALII CATEGORIE</h6>
                    <h1 class="display-4 fw-bold">@Model.Categorie.Nume</h1>
                    <p class="fs-5">Descoperă toate deliciile pregătite în această secțiune specială.</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm text-center p-4">
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-basket3 text-primary fs-2"></i>
                        </div>
                        <h3 class="fw-bold">@Model.Categorie.Produse?.Count()</h3>
                        <p class="text-muted">Produse înscrise</p>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card h-100 border-0 shadow-sm p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Informații Gestiune</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                ID Categorie <span class="badge bg-dark rounded-pill">#@Model.Categorie.Id</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                Status <span class="text-success fw-bold">Activă</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <a asp-page="./Index" class="btn btn-outline-secondary px-4 rounded-pill">Înapoi la Listă</a>
                <a asp-page="./Edit" asp-route-id="@Model.Categorie.Id" class="btn btn-warning px-4 rounded-pill">Modifică Categoria</a>
            </div>
        </div>
    </div>
</div>