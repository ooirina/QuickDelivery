@page
@model IndexModel
@{
    ViewData["Title"] = "QuickDelivery - Comandă acum";
}

@* 1. Hero Section (Banner tip Glovo) *@
<div class="hero-section text-center py-5 mb-5" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1350&q=80'); background-size: cover; color: white; border-radius: 15px;">
    <div class="container py-5">
        <h1 class="display-3 fw-bold">Mâncarea preferată, livrată rapid.</h1>
        <p class="lead">Cele mai bune restaurante din orașul tău la un click distanță.</p>
        <div class="d-flex justify-content-center mt-4">
            <a href="#restaurante" class="btn btn-warning btn-lg px-5 fw-bold text-uppercase">Explorează Restaurante</a>
        </div>
    </div>
</div>

@* 2. Secțiunea de Restaurante *@
<div class="container" id="restaurante">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold">Restaurante recomandate</h2>
            <p class="text-muted">Descoperă arome noi în fiecare zi</p>
        </div>
        <a asp-page="/Restaurante/Index" class="btn btn-outline-primary mb-3">Vezi toate restaurantele</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Restaurante)
        {
            <div class="col">
                <a asp-page="/Restaurante/Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm transition-card">
                        <div style="height: 180px; overflow: hidden; border-radius: 12px 12px 0 0;">
                            @if (!string.IsNullOrEmpty(item.ImagineUrl))
                            {
                                <img src="@item.ImagineUrl" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@item.Nume">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center h-100">
                                    <i class="bi bi-shop text-muted" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.Nume</h5>
                            <div class="d-flex align-items-center text-muted mb-2">
                                <i class="bi bi-star-fill text-warning me-1"></i>
                                <span>4.8 (500+)</span>
                                <span class="mx-2">•</span>
                                <i class="bi bi-clock me-1"></i>
                                <span>25-35 min</span>
                            </div>
                            <p class="card-text small text-secondary">
                                <i class="bi bi-geo-alt me-1"></i> @item.Adresa
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .transition-card {
        transition: all 0.3s ease;
        border-radius: 12px;
    }

        .transition-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .hero-section {
        margin-top: -20px;
    }
</style>