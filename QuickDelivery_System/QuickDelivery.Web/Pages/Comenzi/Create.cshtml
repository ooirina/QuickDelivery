@page
@model QuickDelivery.Web.Pages.Comenzi.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Comanda</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Comanda.DataComanda" class="control-label"></label>
                <input asp-for="Comanda.DataComanda" class="form-control" aria-required="true"/>
