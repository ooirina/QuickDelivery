@page
@model QuickDelivery.Web.Pages.Recenzii.DeleteModel
@{
    ViewData["Title"] = "Ștergere";
}

<h3>Sigur dorești să ștergi această recenzie?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nota</dt>
        <dd class="col-sm-10">@Model.Recenzie.Nota</dd>
        <dt class="col-sm-2">Restaurant</dt>
        <dd class="col-sm-10">@Model.Recenzie.Restaurant.Nume</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Recenzie.Id" />
        <input type="submit" value="Șterge" class="btn btn-danger" /> |
        <a asp-page="./Index">Înapoi la listă</a>
    </form>
</div>