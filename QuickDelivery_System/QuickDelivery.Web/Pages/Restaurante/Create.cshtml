@page
@model QuickDelivery.Web.Pages.Restaurante.CreateModel

@{
    ViewData["Title"] = "Adăugare Restaurant Nou";
}

<div class="container mt-4">
    <h1 class="display-5 text-primary"><i class="bi bi-shop"></i> Adaugă Restaurant</h1>
    <div asp-validation-summary="All" class="text-danger"></div>
    <hr />

    <div class="row shadow-sm p-4 bg-white rounded">
        <div class="col-md-6">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Restaurant.Nume" class="control-label fw-bold"></label>
                    <input asp-for="Restaurant.Nume" class="form-control" placeholder="Ex: Trattoria del Gusto" />
                    <span asp-validation-for="Restaurant.Nume" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Restaurant.Adresa" class="control-label fw-bold"></label>
                    <input asp-for="Restaurant.Adresa" class="form-control" placeholder="Strada, Număr, Oraș" />
                    <span asp-validation-for="Restaurant.Adresa" class="text-danger"></span>
                </div>

                @* Am înlocuit input-ul text pentru ImagineUrl cu un input de tip File *@
                <div class="form-group mb-4">
                    <label class="control-label fw-bold">Imagine Restaurant (Copertă)</label>
                    <input type="file" id="uploadFoto" name="Foto" class="form-control" accept="image/*" />
                    <small class="text-muted">Alege o fotografie reprezentativă pentru restaurant.</small>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-lg"></i> Salvează Restaurantul
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary ms-2">Înapoi la listă</a>
                </div>
            </form>
        </div>

        <div class="col-md-6 text-center">
            <img id="previzualizare" src="#" alt="Previzualizare" class="img-thumbnail d-none" style="max-height: 300px;" />
            <div id="placeholderText" class="text-muted">
                <i class="bi bi-image-fill" style="font-size: 5rem; opacity: 0.2;"></i>
                <p>Previzualizarea va apărea aici după ce selectezi o poză.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ <script>
    document.getElementById('uploadFoto').onchange = evt => {
        const [file] = document.getElementById('uploadFoto').files;
        if (file) {
            document.getElementById('previzualizare').src = URL.createObjectURL(file);
            document.getElementById('previzualizare').classList.remove('d-none');
            document.getElementById('placeholderText').classList.add('d-none');
        }
    }
</script>
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}