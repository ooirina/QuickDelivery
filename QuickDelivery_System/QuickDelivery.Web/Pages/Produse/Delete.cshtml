@page
@model QuickDelivery.Web.Pages.Produse.DeleteModel
@{
    ViewData["Title"] = "Eliminare Produs";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg overflow-hidden">
                <div class="bg-danger py-4 text-center text-white">
                    <i class="bi bi-trash3 fs-1 d-block mb-2"></i>
                    <h3 class="mb-0">Confirmați Ștergerea</h3>
                </div>
                <div class="card-body p-5 text-center">
                    <p class="text-muted mb-4 fs-5">Sigur doriți să eliminați acest produs din ofertă?</p>

                    <div class="bg-light p-4 rounded-3 mb-4">
                        <h4 class="fw-bold text-dark mb-1">@Model.Produs.Nume</h4>
                        <p class="mb-0 text-danger fw-bold fs-5">@Model.Produs.Pret.ToString("F2") RON</p>
                        <hr />
                        <small class="text-muted">Restaurant: @Model.Produs.Restaurant?.Nume</small>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Produs.Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm">Șterge Definitiv</button>
                            <a asp-page="./Index" class="btn btn-light btn-lg">Nu, păstrează produsul</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>