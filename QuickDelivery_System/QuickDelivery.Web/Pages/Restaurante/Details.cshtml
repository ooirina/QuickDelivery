@page
@model QuickDelivery.Web.Pages.Restaurante.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Restaurant</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Restaurant.Nume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Restaurant.Nume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Restaurant.Adresa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Restaurant.Adresa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Restaurant.ImagineUrl)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Restaurant.ImagineUrl)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Restaurant.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
<hr />
<h3>Meniul Restaurantului</h3>
<table class="table">
    <thead>
        <tr>
            <th>Produs</th>
            <th>Preț</th>
            <th>Descriere</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Restaurant.Produse)
        {
            <tr>
                <td>@item.Nume</td>
                <td>@item.Pret RON</td>
                <td>@item.Descriere</td>
            </tr>
        }
    </tbody>
</table>
