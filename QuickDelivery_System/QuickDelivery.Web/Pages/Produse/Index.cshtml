@page
@model QuickDelivery.Web.Pages.Produse.IndexModel

@{
    ViewData["Title"] = "Meniu Produse";
}

<div class="container mt-4">
    @* 1. Secțiune Categorii (Filtrare Vizuală) *@
    <div class="mb-5">
        <h4 class="fw-bold mb-3">Ce ai poftă să mănânci?</h4>
        <div class="d-flex overflow-auto pb-3 gap-3" style="scrollbar-width: none; -ms-overflow-style: none;">
            @* Categorie: Toate *@
            <a href="?handler=Filter" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm">
                    <i class="bi bi-grid-fill text-primary"></i>
                </div>
                <span class="small fw-bold text-dark mt-2">Toate</span>
            </a>

            @* Categorie: Pizza *@
            <a href="?SearchString=Pizza" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm">
                    <i class="bi bi-pie-chart-fill text-danger"></i>
                </div>
                <span class="small fw-bold text-dark mt-2">Pizza</span>
            </a>

            @* Categorie: Burger *@
            <a href="?SearchString=Burger" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm">
                    <i class="bi bi-layers-fill text-warning"></i>
                </div>
                <span class="small fw-bold text-dark mt-2">Burger</span>
            </a>

            @* Categorie: Desert *@
            <a href="?SearchString=Desert" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm">
                    <i class="bi bi-cake2-fill text-info"></i>
                </div>
                <span class="small fw-bold text-dark mt-2">Desert</span>
            </a>

            @* Categorie: Bauturi *@
            <a href="?SearchString=Bauturi" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm">
                    <i class="bi bi-cup-straw text-success"></i>
                </div>
                <span class="small fw-bold text-dark mt-2">Băuturi</span>
            </a>

            @* Categorie: Paste *@
            <a href="?SearchString=Paste" class="category-card text-decoration-none shadow-sm">
                <div class="icon-circle bg-white shadow-sm">
                    <i class="bi bi-infinity text-danger"></i>
                </div>
                <span class="small fw-bold text-dark mt-2">Paste</span>
            </a>
        </div>
    </div>

    @* 2. Header Listă Produse *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Produse disponibile</h2>
        <a asp-page="Create" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Adaugă Produs
        </a>
    </div>

    @* 3. Grid Produse *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Produs)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 transition-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="fw-bold">@item.Nume</h5>
                            <span class="badge bg-success rounded-pill px-3 py-2">@item.Pret.ToString("N2") RON</span>
                        </div>
                        <p class="text-muted small my-2">@item.Descriere</p>
                        <div class="mt-3 p-2 bg-light rounded-3 d-flex align-items-center">
                            <i class="bi bi-shop me-2"></i>
                            <span class="small fw-bold">@item.Restaurant?.Nume</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3 d-flex gap-2">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill flex-grow-1">Editează</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill flex-grow-1">Șterge</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Stiluri pentru cardurile de categorie (iconițe) */
    .category-card {
        min-width: 90px;
        height: 110px;
        background: #ffffff;
        border-radius: 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border: 1px solid #eee;
    }

        .category-card:hover {
            background: #ffffff;
            transform: translateY(-5px);
            border-color: #00c2e8; /* Culoare tip Wolt */
        }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    /* Ascunde scrollbar pentru meniul de categorii */
    .d-flex.overflow-auto::-webkit-scrollbar {
        display: none;
    }

    .transition-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>