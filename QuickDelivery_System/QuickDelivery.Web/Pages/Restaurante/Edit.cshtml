@page
@model QuickDelivery.Web.Pages.Restaurante.EditModel

@{
    ViewData["Title"] = "Editare Restaurant";
}

<div class="container mt-4">
    <h1 class="display-5 text-warning"><i class="bi bi-pencil-square"></i> Editează Restaurant</h1>
    <hr />

    <div class="row shadow-sm p-4 bg-white rounded">
        <div class="col-md-6">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Restaurant.Id" />

                <div class="form-group mb-3">
                    <label asp-for="Restaurant.Nume" class="control-label fw-bold"></label>
                    <input asp-for="Restaurant.Nume" class="form-control" />
                    <span asp-validation-for="Restaurant.Nume" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Restaurant.Adresa" class="control-label fw-bold"></label>
                    <input asp-for="Restaurant.Adresa" class="form-control" />
                    <span asp-validation-for="Restaurant.Adresa" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold">Schimbă Imaginea (opțional)</label>
                    <input type="file" name="Foto" class="form-control" accept="image/*" />
                    <small class="text-muted">Lasă gol dacă nu vrei să schimbi poza actuală.</small>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary px-4">Salvează Modificările</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Anulează</a>
                </div>
            </form>
        </div>

        @* Afișăm poza actuală în partea dreaptă *@
        <div class="col-md-6 text-center">
            <label class="fw-bold d-block mb-2">Imagine Actuală:</label>
            @if (!string.IsNullOrEmpty(Model.Restaurant.ImagineUrl))
            {
                <img src="@Model.Restaurant.ImagineUrl" class="img-thumbnail shadow-sm" style="max-height: 250px;" />
            }
            else
            {
                <div class="alert alert-light border">Nicio imagine încărcată.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}