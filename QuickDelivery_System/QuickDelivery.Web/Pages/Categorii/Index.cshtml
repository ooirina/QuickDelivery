@page
@model QuickDelivery.Web.Pages.Categorii.IndexModel
@{
    ViewData["Title"] = "Administrare Categorii";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold"><i class="bi bi-tags"></i> Categorii Mâncare</h1>
        @if (User.IsInRole("Admin"))
                            {
        <a asp-page="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg"></i> Categorie Nouă
        </a>
                            }
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Iconiță</th>
                    <th>Nume Categorie</th>
                    <th class="text-end pe-4">Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Categorie)
                {
                    <tr>
                        <td class="ps-4">
                            @if (!string.IsNullOrEmpty(item.Iconita))
                            {
                                @* Folosește / la început pentru cale absolută din wwwroot *@
                                <img src="/images/categorii/@item.Iconita"
                                     style="width: 50px; height: 50px; object-fit: contain;"
                                     class="rounded shadow-sm" />
                            }
                            else
                            {
                                <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                            }
                        </td>
                        <td class="align-middle fw-bold">@item.Nume</td>
                        <td class="text-end pe-4 align-middle">
                            <a asp-page="./Details" asp-route-id="@item.Id"
                               class="btn btn-outline-info flex-grow-1 rounded-pill d-flex align-items-center justify-content-center shadow-sm"
                               style="height: 38px;">
                                Detalii
                            </a>
                           @if (User.IsInRole("Admin"))
    {
                                <a asp-page="./Edit" asp-route-id="@item.Id"
                                   class="btn btn-outline-warning flex-grow-1 rounded-pill d-flex align-items-center justify-content-center shadow-sm"
                                   style="height: 38px;">
                                    Editează
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id"
                                   class="btn btn-outline-danger flex-grow-1 rounded-pill d-flex align-items-center justify-content-center shadow-sm"
                                   style="height: 38px;">
                                    Șterge
                                </a>
    }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>