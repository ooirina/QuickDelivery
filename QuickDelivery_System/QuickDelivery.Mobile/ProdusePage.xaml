<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDelivery.Mobile.ProdusePage"
             Title="Meniu Restaurant">

    <Grid RowDefinitions="Auto, *">
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20" Margin="10,5">
            <Label Text="Produse Disponibile" FontSize="22" FontAttributes="Bold" />
            <Button Text="Vezi Recenzii 💬" BackgroundColor="Transparent" TextColor="#512BD4" 
                    FontAttributes="Bold" Clicked="OnViewReviewsClicked" />
        </HorizontalStackLayout>

       

        <CollectionView x:Name="produseList" Grid.Row="2" Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" BorderColor="#512BD4">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nume}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Descriere}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Pret, StringFormat='{0:F2} RON'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Adaugă" Clicked="OnAddToCartClicked" 
                                    CommandParameter="{Binding .}" BackgroundColor="#FFC107" 
                                    TextColor="Black" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>