@page
@model QuickDelivery.Web.Pages.Produse.DetailsModel
@{
    ViewData["Title"] = "Detalii Produs";
}

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Meniu</a></li>
            <li class="breadcrumb-item active">@Model.Produs.Nume</li>
        </ol>
    </nav>

    <div class="card shadow-lg border-0 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-5 position-relative">
                <div class="text-center">
                    <i class="bi bi-box-seam text-primary" style="font-size: 8rem;"></i>
                    <h2 class="mt-3">@Model.Produs.Nume</h2>
                    <span class="badge bg-success fs-4 p-3 shadow-sm rounded-pill">
                        @Model.Produs.Pret.ToString("F2") RON
                    </span>
                </div>
            </div>

            <div class="col-md-7 p-4 p-lg-5 d-flex flex-column">
                <div class="mb-4">
                    <h5 class="text-muted text-uppercase small ls-1 mb-2">Descriere & Ingrediente</h5>
                    <p class="lead text-dark">@Model.Produs.Descriere</p>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <h6 class="text-muted small">Restaurant</h6>
                        <p class="h6"><i class="bi bi-shop"></i> @Model.Produs.Restaurant.Nume</p>
                    </div>
                    <div class="col-6">
                        <h6 class="text-muted small">Categorie</h6>
                        <p class="h6"><i class="bi bi-tag"></i> @Model.Produs.Categorie.Nume</p>
                    </div>
                </div>

                <div class="mt-auto d-flex gap-3">
                    <button class="btn btn-primary btn-lg flex-grow-1 shadow">
                        <i class="bi bi-cart-plus"></i> Adaugă în Coș
                    </button>
                    <a asp-page="./Edit" asp-route-id="@Model.Produs.Id" class="btn btn-outline-warning btn-lg">
                        <i class="bi bi-pencil"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>