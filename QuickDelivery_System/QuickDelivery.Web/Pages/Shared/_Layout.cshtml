<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickDelivery</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuickDelivery.Web.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f5f5dc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .card {
            background-color: #ffffff;
            border: none;
        }

        .container {
            padding-top: 20px;
        }

        .footer {
            background-color: #ffffff;
            line-height: 20px; /* Înălțime redusă */
            width: 100%;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                @* Logo-ul *@
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-page="/Index">
                    <i class="bi bi-lightning-fill text-warning"></i> QuickDelivery
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @* Adăugăm link-urile către paginile de administrare *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Restaurante/Index">Restaurante</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Produse/Index">Produse</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Clienti/Index">Clienți</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Categorii/Index"> Categorii</a>
                        
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Comenzi/Index"> Comenzi</a>

                        </li>
                    </ul>
                    @* Un buton de "Coș" simulat pentru aspect profesional *@
                    <div class="d-flex">
                        <a href="#" class="btn btn-outline-dark rounded-pill">
                            <i class="bi bi-cart3"></i> Coș
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted shadow-sm">
        <div class="container text-center">
            <span>&copy; 2026 - <span class="fw-bold text-dark">QuickDelivery</span>. Toate drepturile rezervate. | <a asp-area="" asp-page="/Privacy" class="text-decoration-none">Politică de Confidențialitate</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>