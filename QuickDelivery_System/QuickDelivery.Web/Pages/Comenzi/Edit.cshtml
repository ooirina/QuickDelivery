@page
@model QuickDelivery.Web.Pages.Comenzi.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Comanda</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Comanda.Id" />

            @* Păstrăm ClientId ascuns pentru ca modelul să rămână valid la salvare *@
            <input type="hidden" asp-for="Comanda.ClientId" />

            <div class="form-group mb-3">
                <label asp-for="Comanda.DataComanda" class="control-label"></label>
                <input asp-for="Comanda.DataComanda" class="form-control" />
                <span asp-validation-for="Comanda.DataComanda" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comanda.RestaurantId" class="control-label">Restaurant</label>
                <select asp-for="Comanda.RestaurantId" class="form-control" asp-items="ViewBag.RestaurantId"></select>
                <span asp-validation-for="Comanda.RestaurantId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comanda.ProdusId" class="control-label">Mâncare (Produs)</label>
                <select asp-for="Comanda.ProdusId" class="form-control" asp-items="ViewBag.ProdusId"></select>
                <span asp-validation-for="Comanda.ProdusId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comanda.Cantitate" class="control-label"></label>
                <input asp-for="Comanda.Cantitate" class="form-control" type="number" min="1" />
                <span asp-validation-for="Comanda.Cantitate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comanda.AdresaLivrare" class="control-label">Adresa de Livrare</label>
                <input asp-for="Comanda.AdresaLivrare" class="form-control" />
                <span asp-validation-for="Comanda.AdresaLivrare" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Comanda.Status" class="control-label"></label>
                @if (User.IsInRole("Admin"))
                {
                    @* Adminul poate schimba statutul dintr-o listă *@
                    <select asp-for="Comanda.Status" class="form-control">
                        <option value="In preparare">In preparare</option>
                        <option value="In livrare">In livrare</option>
                        <option value="Finalizata">Finalizata</option>
                    </select>
                }
                else
                {
                    @* Clientul vede statutul fără să-l poată modifica *@
                    <input asp-for="Comanda.Status" class="form-control" readonly />
                }
                <span asp-validation-for="Comanda.Status" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}